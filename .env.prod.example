# Env vars for the Dokploy compose deploy (docker-compose.prod.yml).
# Set these in the Dokploy UI (Environment) — do NOT commit real values.
POSTGRES_PASSWORD=change-me
GROQ_API_KEY=
# DOL Open Data Portal key — enrichment fires when you add a sub (best-effort, rate-limited).
API_KEY_ODP=
# Optional (defaults shown):
GROQ_MODEL=openai/gpt-oss-120b
